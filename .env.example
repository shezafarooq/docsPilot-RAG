# Paste your key into .env, never into source code or chat.
GEMINI_API_KEY=
# Tested free-tier model; availability and quotas depend on your project.
GEMINI_MODEL=gemini-3.5-flash-lite

# Compose uses the service name; host-run Python would use localhost instead.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=docspilot
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional until the tracing step. Use the URL shown in your Langfuse project.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
TRACING_ENABLED=true
